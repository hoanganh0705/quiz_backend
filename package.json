{
  "name": "quiz_backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "debug": "NEST_DEBUG=true nest start --watch --entryFile debug",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test,scripts}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "NODE_OPTIONS=--experimental-vm-modules node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "db:start": "docker start quizdb || docker run -d --name quizdb -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=quizdb -p 5432:5432 -v quizdb_data:/var/lib/postgresql postgres:18",
    "db:stop": "docker stop quizdb",
    "db:cleanall": "docker exec -i quizdb psql -U postgres -d quizdb -c \"DO \\$\\$ DECLARE r RECORD; BEGIN FOR r IN (SELECT tablename FROM pg_tables WHERE schemaname = 'public') LOOP EXECUTE 'TRUNCATE TABLE ' || quote_ident(r.tablename) || ' RESTART IDENTITY CASCADE'; END LOOP; END \\$\\$;\"",
    "db:reset": "docker rm -f quizdb && docker volume rm quizdb_data",
    "db:generate": "pnpm drizzle-kit generate",
    "db:migrate": "pnpm drizzle-kit migrate",
    "db:push": "pnpm drizzle-kit push",
    "db:check": "pnpm drizzle-kit check",
    "db:introspect": "pnpm drizzle-kit introspect",
    "db:seed:foundation": "node -r ts-node/register -r tsconfig-paths/register src/commands/seed/index.ts foundation",
    "db:seed:development": "node -r ts-node/register -r tsconfig-paths/register src/commands/seed/index.ts development",
    "db:seed:scenarios": "node -r ts-node/register -r tsconfig-paths/register src/commands/seed/index.ts scenarios",
    "db:seed:all": "node -r ts-node/register -r tsconfig-paths/register src/commands/seed/index.ts all",
    "db:backfill:user-streak": "node -r ts-node/register -r tsconfig-paths/register scripts/backfill/user-streak.ts",
    "db:backfill:user-streak:dry-run": "node -r ts-node/register -r tsconfig-paths/register scripts/backfill/user-streak.ts --dry-run",
    "db:backfill:bookmark-metrics": "node -r ts-node/register -r tsconfig-paths/register scripts/backfill/bookmark-metrics.ts",
    "db:backfill:quiz-metrics": "node -r ts-node/register -r tsconfig-paths/register scripts/backfill/quiz-metrics.ts",
    "outbox:inspect": "node -r ts-node/register -r tsconfig-paths/register src/commands/outbox.ts inspect",
    "outbox:retry": "node -r ts-node/register -r tsconfig-paths/register src/commands/outbox.ts retry",
    "outbox:discard": "node -r ts-node/register -r tsconfig-paths/register src/commands/outbox.ts discard",
    "seed:reset": "pnpm db:cleanall && pnpm db:seed:all",
    "redis:start": "docker start quizredis || docker run -d --name quizredis -p 6379:6379 redis:8",
    "redis:stop": "docker stop quizredis",
    "redis:reset": "docker rm -f quizredis",
    "redis:cleanall": "docker exec -i quizredis redis-cli FLUSHALL",
    "generate:openapi": "curl http://localhost:8080/api/v1/docs/openapi.json > docs/generated/openapi.json",
    "smoke:openapi": "bash scripts/smoke-openapi.sh",
    "audit:ci": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/common": "^12.1.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/platform-socket.io": "^12.1.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.1.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "dataloader": "^2.2.3",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "google-auth-library": "^11.1.0",
    "graphql": "^16.11.0",
    "graphql-depth-limit": "^1.1.0",
    "graphql-query-complexity": "^2.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "multer": "^2.4.0",
    "nestjs-pino": "^5.2.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-std-serializers": "^7.1.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.30.0",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.2"
  },
  "pnpm": {
    "overrides": {
      "lodash": ">=4.18.0",
      "fast-uri": ">=3.1.3",
      "picomatch": ">=4.0.4",
      "form-data": ">=4.0.6"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@typescript-eslint/rule-tester": "^8.70.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}

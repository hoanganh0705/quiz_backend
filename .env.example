# ===========================================
# Quiz Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ===========================================

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quizdb

# Redis
REDIS_URL=redis://localhost:6379

# JWT — MUST be different, cryptographically random secrets (≥256 bits)
# Generate with: openssl rand -base64 32
JWT_ACCESS_TOKEN_SECRET=<generate-a-random-secret>
JWT_REFRESH_TOKEN_SECRET=<generate-a-different-random-secret>
JWT_ACCESS_TOKEN_ISSUER=quiz-backend
JWT_ACCESS_TOKEN_AUDIENCE=quiz-client
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_COOKIE_MAX_AGE_MS=604800000

# Sessions
MAX_ACTIVE_SESSIONS_PER_USER=5
REFRESH_TOKEN_REUSE_GRACE_WINDOW_SECONDS=10
SESSION_BINDING_STRICT=false

# Email Verification
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=3600
EMAIL_VERIFICATION_BASE_URL=http://localhost:8080/api/auth/verify-email
# Email (Resend)
# Provider: always 'resend'
# API Key: get from https://resend.com → API Keys
# From Address options:
#   - Testing (no domain setup needed): onboarding@resend.dev
#     (only delivers to the Resend account owner's email)
#   - Production: noreply@your-domain.com
#     (requires domain verified in Resend dashboard first)
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=Quiz App Support
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_<your-api-key-from-resend-dashboard>

# Server
TRUST_PROXY=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
NODE_ENV=development
PORT=8080

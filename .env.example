# ===========================================
# Quiz Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
#
# Source of truth: quiz_backend/src/core/config/env.validation.ts
# Regenerated by ET-1.5-B2 (Epic 1.5, Batch B). Every key declared by
# validateEnv() is present below, alphabetically ordered, with a
# comment describing it and a safe placeholder default.
# ===========================================

# Access-token expiration duration. Format: number with optional
# unit suffix (s|m|h|d). Example: 15m, 1h, 7d.
ACCESS_TOKEN_EXPIRES_IN=15m

# Free-form description of the API, surfaced in OpenAPI metadata.
APP_DESCRIPTION=REST API for the quiz application

# Display name of the API, surfaced in OpenAPI metadata.
APP_NAME=Quiz API

# Public absolute URL of the API, surfaced in OpenAPI metadata.
APP_URL=http://localhost:8080

# Semantic version string, surfaced in OpenAPI metadata.
APP_VERSION=1.0

# Comma-separated list of allowed CORS origins. Empty disables CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Postgres connection string. Must use postgres:// or postgresql://.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/quizdb

# Sender "From" address used by the email provider.
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# Sender "From" display name used by the email provider.
EMAIL_FROM_NAME=Quiz App Support# Email provider identifier. Must be one of: resend.
EMAIL_PROVIDER=resend

# Number of worker concurrency for the email send queue.
# Defaults to 5 when unset.
EMAIL_QUEUE_CONCURRENCY=5

# Per-send timeout for the email provider HTTP call, in milliseconds.
# Defaults to 5000 when unset.
EMAIL_SEND_TIMEOUT_MS=5000

# Absolute URL prefix used when building email-verification links.
EMAIL_VERIFICATION_BASE_URL=http://localhost:8080/api/auth/verify-email

# Lifetime of an email-verification token, in seconds.
# Defaults to 1800 when unset.
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=3600

# Consecutive Resend failures required to open the email circuit breaker.
# Defaults to 5 when unset.
EMAIL_CB_FAILURE_THRESHOLD=5

# Cool-down (ms) the email circuit breaker stays open before allowing a probe.
# Defaults to 30000 when unset.
EMAIL_CB_RESET_TIMEOUT_MS=30000

# Audience claim expected on signed JWT access tokens.
JWT_ACCESS_TOKEN_AUDIENCE=quiz-client

# Issuer claim stamped on signed JWT access tokens.
JWT_ACCESS_TOKEN_ISSUER=quiz-backend

# HMAC secret for signing access tokens. MUST be cryptographically
# random (>=256 bits / 32 chars, >=16 distinct chars).
# Generate with: openssl rand -base64 32
JWT_ACCESS_TOKEN_SECRET=<generate-a-random-secret>

# HMAC secret for signing refresh tokens. MUST differ from the access
# token secret, must satisfy the same entropy constraint (>=32 chars,
# >=16 distinct chars).
# Generate with: openssl rand -base64 32
JWT_REFRESH_TOKEN_SECRET=<generate-a-different-random-secret>

# Prometheus scrape token. Used by the /metrics endpoint to gate
# Prometheus scrapes. Required in production; if unset, the /metrics
# endpoint stays open (and env.validation.ts will refuse to boot).
# Set to a high-entropy random string and configure your Prometheus
# scraper to send `X-Prometheus-Token: <value>`.
PROMETHEUS_SCRAPE_TOKEN=

# Max concurrent active sessions allowed per user. Defaults to 5.
MAX_ACTIVE_SESSIONS_PER_USER=5

# Runtime environment. Must be one of: development, test, production.
NODE_ENV=development

# Port the HTTP server binds to. Defaults to 3000.
PORT=8080

# RESEND_API_KEY
# API Key for the Resend email provider. Get one from
# https://resend.com → API Keys. Sample placeholder only.
RESEND_API_KEY=re_<your-api-key-from-resend-dashboard>

# Redis connection string. Must use redis:// or rediss://.
REDIS_URL=redis://localhost:6379

# Refresh-token cookie max-age, in milliseconds. Must be a positive
# integer (no fallback in validateEnv).
REFRESH_TOKEN_COOKIE_MAX_AGE_MS=604800000

# Refresh-token expiration duration. Format: number with optional
# unit suffix (s|m|h|d). Example: 7d, 30d, 24h.
REFRESH_TOKEN_EXPIRES_IN=7d

# Grace window (seconds) during which a previously-used refresh token
# is still accepted after rotation. Defaults to 10.
REFRESH_TOKEN_REUSE_GRACE_WINDOW_SECONDS=10

# When true, sessions are bound to client fingerprint in addition to
# the refresh token. Defaults to false.
SESSION_BINDING_STRICT=false

# When true, Express trusts the X-Forwarded-* headers from upstream
# proxies. Set this to `true` only behind a known reverse proxy that
# strips and re-injects these headers; otherwise leave it `false` so
# spoofed client IPs cannot bypass rate-limits or fudge audit logs.
TRUST_PROXY=false

# ----
# The following keys are read elsewhere in the codebase but are NOT
# declared by validateEnv(). They are preserved here for parity with
# the previous example file and are intentionally not alphabetized
# with the keys above.
# ----

# Password reset (read outside validateEnv)
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password

# Tournament module feature flags.
# When true, the BullMQ publisher path is skipped and tournament events flow
# exclusively through the transactional outbox (canonical publisher).
# Set TOURNAMENT_BULLMQ_DISABLE=false to re-enable the duplicate path for
# emergency rollback only.
TOURNAMENT_BULLMQ_DISABLE=true

# Cloudinary cloud name (visible in the dashboard URL).
CLOUDINARY_CLOUD_NAME=change-me

# Cloudinary API key. NEVER expose to the frontend.
CLOUDINARY_API_KEY=change-me

# Cloudinary API secret. NEVER expose to the frontend. Server-only.
CLOUDINARY_API_SECRET=change-me

# Cloudinary folder prefix. The adapter composes public_id as
# `${CLOUDINARY_FOLDER}/${ownerId}/${uuidv7}`. Two values are kept here
# so dev and prod cannot collide:
#   - dev:      quiz-app-dev
#   - prod:     quiz-app
CLOUDINARY_FOLDER=quiz-app-dev

# ===========================================
# Newly-documented keys (validated by validateEnv)
# ===========================================
# These were previously read directly from process.env outside the boot
# validator. They are now first-class validated keys; the comments above
# the alphabetized block still apply for the PASSWORD_RESET_* and
# CLOUDINARY_* groups.

# ALLOW_PROD_SEED must never be true in production (emergency escape hatch only).
ALLOW_PROD_SEED=false

# AUTH_AUDIT_RETENTION_DAYS — retention window for auth audit rows in days.
# Defaults to 365.
AUTH_AUDIT_RETENTION_DAYS=365

# AUTH_OUTBOX_BASE_DELAY_SECONDS — base delay between auth outbox retry attempts.
# Defaults to 30.
AUTH_OUTBOX_BASE_DELAY_SECONDS=30

# AUTH_OUTBOX_MAX_RETRIES — maximum number of auth outbox retry attempts.
# Defaults to 8.
AUTH_OUTBOX_MAX_RETRIES=8

# AUTH_SESSION_INVALIDATION_CHANNEL — Redis pub/sub channel used to broadcast
# session invalidation events across instances. Defaults to
# `auth:session:invalidate`.
AUTH_SESSION_INVALIDATION_CHANNEL=auth:session:invalidate

# COIN_ADMIN_DAILY_CAP_PER_ADMIN — max coins an admin role can grant per UTC
# day across all adjustments. Defaults to 10_000_000.
COIN_ADMIN_DAILY_CAP_PER_ADMIN=10000000

# DISABLE_REDIS_SOCKET_ADAPTER — when true, the app skips wiring the
# Redis adapter and falls back to the default in-memory socket adapter.
# Defaults to false.
DISABLE_REDIS_SOCKET_ADAPTER=false

# GOOGLE_CLIENT_ID — OAuth client ID issued by the Google Cloud Console.
# Required in production; optional in dev/test.
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com

# GOOGLE_HOSTED_DOMAIN — optional; restrict Google sign-in to a specific
# hosted domain (e.g. "example.com"). Empty disables the restriction.
GOOGLE_HOSTED_DOMAIN=

# PASSWORD_HISTORY_SIZE — number of previous password hashes to retain
# per user for reuse prevention. Defaults to 5.
PASSWORD_HISTORY_SIZE=5

# RETRY_QUEUE_DLQ_*_KEY — Redis list key prefix for the dead-letter queue
# per tier (attempt/coin/comment). Each defaults to `tier:<tier>:dlq`.
RETRY_QUEUE_DLQ_ATTEMPT_KEY=tier:attempt:dlq
RETRY_QUEUE_DLQ_COIN_KEY=tier:coin:dlq
RETRY_QUEUE_DLQ_COMMENT_KEY=tier:comment:dlq

# SWAGGER_ENABLED — force the Swagger UI to be exposed even in production.
# Defaults to false (UI is otherwise dev/test only).
SWAGGER_ENABLED=true

# TOURNAMENT_QUEUE_CONCURRENCY — BullMQ worker concurrency for the
# tournament event processor. Defaults to 5.
TOURNAMENT_QUEUE_CONCURRENCY=5